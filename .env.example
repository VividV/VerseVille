# Supabase project for optional accounts and cloud sync (Phase 8).
# Copy to .env.local for local development, and add the same two variables in
# Vercel → Project → Settings → Environment Variables.
# Use the PUBLISHABLE (anon) key only — never the service_role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
